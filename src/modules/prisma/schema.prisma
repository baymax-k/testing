generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  mentor
  instructor_staff
  dept_admin
  hod
  principal
  college_admin
  super_admin
  product_admin
}

enum SubmissionStatus {
  processing
  accepted
  wrong_answer
  time_limit_exceeded
  memory_limit_exceeded
  runtime_error
  compilation_error
  internal_error
}

enum ContestType {
  contest
  practice
}

enum TestStatus {
  draft
  scheduled
  active
  completed
  archived
}

enum QuestionType {
  // Practice/contest problem types
  mcq
  dsa
  // Test management question types
  multiple_choice
  true_false
  short_answer
  long_answer
  coding
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  username      String      @unique @default(cuid())
  name          String
  passwordHash  String      @default("")
  role          Role        @default(student)
  emailVerified Boolean     @default(false)
  image         String?
  phone         String?
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  batchId       String?
  batch         Batch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // JWT auth flow
  refreshTokens RefreshToken[]

  // Better Auth flow
  sessions Session[]
  accounts Account[]

  // Practice/contest flow
  submissions    Submission[]
  participations ContestParticipation[]

  // College-admin flow
  mentoredBatches Batch[]      @relation("BatchMentor")
  createdTests    Test[]       @relation("TestCreatedBy")
  testAttempts    TestAttempt[] @relation("StudentTestAttempts")

  @@index([departmentId])
  @@index([batchId])
  @@index([role])
  @@map("user")
}

model RefreshToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  hodId       String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  batches     Batch[]
  tests       Test[]

  @@map("department")
}

model Batch {
  id           String      @id @default(cuid())
  name         String
  code         String
  year         Int
  semester     Int?
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  mentorId     String?
  mentor       User?       @relation("BatchMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  students     User[]
  tests        Test[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([code, departmentId])
  @@index([departmentId])
  @@index([mentorId])
  @@map("batch")
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  type      String
  questions Question[]

  @@map("tag")
}

model Question {
  id          String       @id @default(cuid())
  type        QuestionType

  // Practice/contest problem fields
  title       String?
  description String?
  difficulty  String?
  tags        Tag[]
  company     String?
  createdBy   String?

  // Shared/answer fields
  options       Json?
  correctAnswer String?
  correctOption Int?
  explanation   String?

  // DSA-specific
  timeLimit       Int?
  memoryLimit     Int?
  sampleTestCases Json?
  hiddenTestCases Json?

  // Contest relation
  contests ContestQuestion[]

  // Test-management relation
  testId     String?
  test       Test?      @relation(fields: [testId], references: [id], onDelete: Cascade)
  content    String?
  marks      Int        @default(1)
  orderIndex Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([testId])
  @@index([orderIndex])
  @@map("question")
}

model Contest {
  id          String      @id @default(cuid())
  title       String
  description String
  type        ContestType @default(contest)
  startTime   DateTime?
  endTime     DateTime?
  duration    Int?
  createdBy   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  questions      ContestQuestion[]
  participations ContestParticipation[]

  @@map("contest")
}

model ContestQuestion {
  contestId  String
  questionId String
  order      Int
  points     Int

  contest  Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([contestId, questionId])
  @@map("contest_question")
}

model ContestParticipation {
  id          String    @id @default(cuid())
  userId      String
  contestId   String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Int       @default(0)
  mcqAnswers  Json?

  dsaSubmissions Submission[]
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest        Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([userId, contestId])
  @@map("contest_participation")
}

model Submission {
  id              String           @id @default(cuid())
  userId          String
  problemId       String
  language        String?
  languageId      Int?
  sourceCode      String?
  status          SubmissionStatus @default(processing)
  testCasesPassed Int              @default(0)
  totalTestCases  Int              @default(0)
  failedAt        Int?
  runtime         String?
  memory          Int?
  errorOutput     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  contestParticipationId String?
  contestParticipation   ContestParticipation? @relation(fields: [contestParticipationId], references: [id])
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([problemId])
  @@index([userId, problemId])
  @@map("submission")
}

model Test {
  id                  String       @id @default(cuid())
  title               String
  description         String?
  instructions        String?
  status              TestStatus   @default(draft)
  durationMinutes     Int          @default(60)
  maxAttempts         Int          @default(1)
  totalMarks          Int          @default(0)
  passingMarks        Int?
  scheduledStartTime  DateTime?
  scheduledEndTime    DateTime?
  departmentId        String?
  department          Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  batchId             String?
  batch               Batch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdById         String
  createdBy           User         @relation("TestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  questions           Question[]
  attempts            TestAttempt[]

  @@index([status])
  @@index([departmentId])
  @@index([batchId])
  @@index([createdById])
  @@index([scheduledStartTime])
  @@map("test")
}

model TestAttempt {
  id            String    @id @default(cuid())
  testId        String
  test          Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId     String
  student       User      @relation("StudentTestAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber Int       @default(1)
  status        String    @default("in_progress")
  score         Float?
  maxScore      Float
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  evaluatedAt   DateTime?
  answers       Json?
  feedback      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([testId, studentId, attemptNumber])
  @@index([testId])
  @@index([studentId])
  @@index([status])
  @@map("test_attempt")
}
