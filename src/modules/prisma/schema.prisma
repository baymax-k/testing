generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  student
  mentor
  instructor_staff
  dept_admin
  hod
  principal
  college_admin
  product_admin
}

enum SubmissionStatus {
  processing
  accepted
  wrong_answer
  time_limit_exceeded
  memory_limit_exceeded
  runtime_error
  compilation_error
  internal_error
}

enum ContestType {
  contest
  practice
}

enum TestStatus {
  draft
  scheduled
  active
  completed
  archived
}

enum HackathonStatus {
  draft
  registration_open
  in_progress
  completed
  cancelled
}

enum QuestionType {
  // Practice/contest problem types
  mcq
  dsa
  // Test management question types
  multiple_choice
  true_false
  short_answer
  long_answer
  coding
}

enum ProductAdminPage {
  dashboard
  colleges
  hackathons
  public_tests
  public_problems
  problems
  mcq_list
  rbac
  users_management
  settings
}

enum McqSessionStatus {
  in_progress
  submitted
}

// ─── Auth Models ─────────────────────────────────────────────────────────────

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  username      String      @unique @default(cuid())
  name          String
  passwordHash  String      @default("")
  role          Role        @default(student)
  emailVerified Boolean     @default(false)
  image         String?
  phone         String?
  collegeId     String?
  college       College?    @relation("CollegeUsers", fields: [collegeId], references: [id], onDelete: SetNull)
  departmentId  String?
  department    Department? @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  batchId       String?
  batch         Batch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // JWT auth flow
  refreshTokens RefreshToken[]

  // Better Auth flow
  sessions Session[]
  accounts Account[]

  // Practice/contest flow
  submissions    Submission[]
  participations ContestParticipation[]
  mcqSessions    McqPracticeSession[]
  dailySolves    DailyChallengeSolve[]
  streak         UserStreak?
  dailyPracticeActivities DailyPracticeActivity[]
  practiceRandomSets      PracticeRandomSet[]

  // College/Organization management (Product Admin)
  collegesAdministered College[] @relation("CollegeAdmin")
  collegesCreated       College[] @relation("CollegeCreatedBy")

  // College-admin flow
  mentoredBatches Batch[]      @relation("BatchMentor")
  createdTests    Test[]       @relation("TestCreatedBy")
  testAttempts    TestAttempt[] @relation("StudentTestAttempts")
  productAdminSettings ProductAdminSettings?
  productAdminPagePermissions ProductAdminPagePermission[] @relation("ProductAdminPagePermissions")
  departmentAsHod Department?  @relation("DepartmentHod")

  // Hackathon management
  hackathonsCreated HackathonTeam[] @relation("HackathonTeamLead")
  hackathonsCreatedByUser Hackathon[] @relation("HackathonCreator")
  hackathonParticipations HackathonParticipant[] @relation("HackathonParticipants")

  @@index([collegeId])
  @@index([departmentId])
  @@index([batchId])
  @@index([role])
  @@map("user")
}

model RefreshToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── College & Organization Models ───────────────────────────────────────────

model College {
  id             String       @id @default(cuid())
  name           String       @unique
  code           String       @unique
  description    String?
  website        String?
  location       String?
  adminId        String?      @unique
  admin          User?        @relation("CollegeAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User         @relation("CollegeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  departments    Department[]
  users          User[]       @relation("CollegeUsers")
  hackathons     Hackathon[]

  @@index([adminId])
  @@index([createdById])
  @@map("college")
}

model ProductAdminSettings {
  id                           String   @id @default(cuid())
  userId                       String   @unique
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Notification settings
  emailNotifications           Boolean  @default(true)
  notifyOnCollegeCreation      Boolean  @default(true)
  notifyOnAdminAssignment      Boolean  @default(true)
  notifyOnUserRegistration     Boolean  @default(false)
  
  // Display preferences
  theme                        String   @default("light")
  language                     String   @default("en")
  itemsPerPage                 Int      @default(10)
  
  // Other settings
  twoFactorEnabled             Boolean  @default(false)
  sessionTimeout               Int      @default(3600) // seconds
  
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@map("product_admin_settings")
}

model ProductAdminPagePermission {
  id          String           @id @default(cuid())
  adminUserId String
  adminUser   User             @relation("ProductAdminPagePermissions", fields: [adminUserId], references: [id], onDelete: Cascade)
  page        ProductAdminPage
  canView     Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([adminUserId, page])
  @@index([adminUserId])
  @@index([page])
  @@map("product_admin_page_permission")
}

model Department {
  id          String   @id @default(cuid())
  name        String
  code        String
  description String?
  collegeId   String
  college     College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  hodId       String?   @unique
  hod         User?     @relation("DepartmentHod", fields: [hodId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  users       User[]    @relation("UserDepartment")
  batches     Batch[]
  tests       Test[]

  @@unique([code, collegeId])
  @@unique([name, collegeId])
  @@index([collegeId])
  @@map("department")
}

model Batch {
  id           String      @id @default(cuid())
  name         String
  code         String
  year         Int
  semester     Int?
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  mentorId     String?
  mentor       User?       @relation("BatchMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  students     User[]
  tests        Test[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([code, departmentId])
  @@index([departmentId])
  @@index([mentorId])
  @@map("batch")
}

// ─── Problem Models ──────────────────────────────────────────────────────────

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  type      String
  questions Question[]

  @@map("tag")
}

model Question {
  id          String       @id @default(cuid())
  type        QuestionType

  // Practice/contest problem fields
  title       String?
  description String?
  difficulty  String?
  tags        Tag[]
  company     String?
  createdBy   String?

  // Shared/answer fields
  options       Json?
  correctAnswer String?
  correctOption Int?
  explanation   String?

  // DSA-specific
  timeLimit       Int?
  memoryLimit     Int?
  sampleTestCases Json?
  hiddenTestCases Json?

  // Contest relation
  contests ContestQuestion[]
  mcqAnswers McqPracticeAnswer[]
  dailyChallenges DailyChallenge[]

  // Test-management relation
  testId     String?
  test       Test?      @relation(fields: [testId], references: [id], onDelete: Cascade)
  content    String?
  marks      Int        @default(1)
  orderIndex Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([testId])
  @@index([orderIndex])
  @@map("question")
}

model Contest {
  id          String      @id @default(cuid())
  title       String
  description String
  type        ContestType @default(contest)
  startTime   DateTime?
  endTime     DateTime?
  duration    Int?
  createdBy   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  questions      ContestQuestion[]
  participations ContestParticipation[]

  @@map("contest")
}

model ContestQuestion {
  contestId  String
  questionId String
  order      Int
  points     Int

  contest  Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([contestId, questionId])
  @@map("contest_question")
}

model ContestParticipation {
  id          String    @id @default(cuid())
  userId      String
  contestId   String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Int       @default(0)
  mcqAnswers  Json?

  dsaSubmissions Submission[]
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest        Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([userId, contestId])
  @@map("contest_participation")
}

model Submission {
  id              String           @id @default(cuid())
  userId          String
  problemId       String
  language        String?
  languageId      Int?
  sourceCode      String?
  status          SubmissionStatus @default(processing)
  testCasesPassed Int              @default(0)
  totalTestCases  Int              @default(0)
  failedAt        Int?
  runtime         String?
  memory          Int?
  errorOutput     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  contestParticipationId String?
  contestParticipation   ContestParticipation? @relation(fields: [contestParticipationId], references: [id])
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([problemId])
  @@index([userId, problemId])
  @@map("submission")
}

model Test {
  id                  String       @id @default(cuid())
  title               String
  description         String?
  instructions        String?
  status              TestStatus   @default(draft)
  durationMinutes     Int          @default(60)
  maxAttempts         Int          @default(1)
  totalMarks          Int          @default(0)
  passingMarks        Int?
  scheduledStartTime  DateTime?
  scheduledEndTime    DateTime?
  departmentId        String?
  department          Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  batchId             String?
  batch               Batch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdById         String
  createdBy           User         @relation("TestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  
  // Public availability
  isPublic            Boolean      @default(false)
  difficulty          String?      @default("medium") // easy, medium, hard
  tags                String[]     @default([])        // ["DSA", "DP", "Arrays"] etc
  
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  questions           Question[]
  attempts            TestAttempt[]

  @@index([status])
  @@index([isPublic])
  @@index([departmentId])
  @@index([batchId])
  @@index([createdById])
  @@index([scheduledStartTime])
  @@index([difficulty])
  @@map("test")
}

model TestAttempt {
  id            String    @id @default(cuid())
  testId        String
  test          Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId     String
  student       User      @relation("StudentTestAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber Int       @default(1)
  status        String    @default("in_progress")
  score         Float?
  maxScore      Float
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  evaluatedAt   DateTime?
  answers       Json?
  feedback      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([testId, studentId, attemptNumber])
  @@index([testId])
  @@index([studentId])
  @@index([status])
  @@map("test_attempt")
}

model McqPracticeSession {
  id             String           @id @default(cuid())
  userId         String
  topics         Json
  difficulty     String?
  requestedCount Int
  totalQuestions Int
  questionIds    Json
  status         McqSessionStatus @default(in_progress)
  score          Int              @default(0)
  correctCount   Int              @default(0)
  submittedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers McqPracticeAnswer[]

  @@index([userId])
  @@index([userId, createdAt])
  @@map("mcq_practice_session")
}

model McqPracticeAnswer {
  id             String   @id @default(cuid())
  sessionId      String
  questionId     String
  selectedOption Int
  correctAnswer  Int
  isCorrect      Boolean
  points         Int      @default(0)
  createdAt      DateTime @default(now())

  session  McqPracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
  @@map("mcq_practice_answer")
}

// ─── Problem of the Day Models ───────────────────────────────────────────────

model DailyChallenge {
  id         String   @id @default(cuid())
  questionId String
  date       DateTime @unique @db.Date
  createdBy  String   // admin user ID or "system" for auto-select
  createdAt  DateTime @default(now())

  question Question              @relation(fields: [questionId], references: [id])
  solves   DailyChallengeSolve[]

  @@index([date])
  @@map("daily_challenge")
}

model DailyChallengeSolve {
  id               String   @id @default(cuid())
  userId           String
  dailyChallengeId String
  selectedOption   Int?
  languageId       Int?     // for DSA code submissions
  sourceCode       String?  // for DSA code submissions
  isCorrect        Boolean
  attempts         Int      @default(1)
  solvedAt         DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyChallenge DailyChallenge @relation(fields: [dailyChallengeId], references: [id], onDelete: Cascade)

  @@unique([userId, dailyChallengeId])
  @@index([userId])
  @@map("daily_challenge_solve")
}

model UserStreak {
  id            String    @id @default(cuid())
  userId        String    @unique
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastSolveDate DateTime? @db.Date
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streak")
}

// ─── Daily Practice Activity ─────────────────────────────────────────────────
model DailyPracticeActivity {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @db.Date
  problemsSolved Int      @default(0)
  mcqSolved      Int      @default(0)
  dsaSolved      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_practice_activity")
}

// ─── Random Practice Sets (Ephemeral, persisted for auditing) ───────────────
model PracticeRandomSet {
  id          String   @id @default(cuid())
  userId      String
  seed        String?
  filters     Json     // { topics: string[], difficulty?: string }
  questionIds Json     // [questionId]
  count       Int
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("practice_random_set")
}

// ─── Hackathon Management ────────────────────────────────────────────────────
model Hackathon {
  id              String            @id @default(cuid())
  title           String            @db.VarChar(255)
  description     String?           @db.Text
  shortDescription String?          @db.VarChar(500)
  collegeId       String
  createdByUserId String            // Product admin who created it
  
  // Timing
  startDate       DateTime
  endDate         DateTime
  registrationDeadline DateTime?
  
  // Settings
  status          HackathonStatus   @default(draft)
  maxTeams        Int?              // null = unlimited
  maxTeamSize     Int               @default(5)
  minTeamSize     Int               @default(1)
  theme           String?           // e.g., "AI/ML", "Web Development"
  problemStatementUrl String?       @db.VarChar(500)
  
  // Visibility & Rules
  isPublic        Boolean           @default(true)
  allowRemoteParticipation Boolean @default(true)
  prizesInfo      String?           @db.Text     // JSON or description
  rulesUrl        String?           @db.VarChar(500)
  
  // Tracking
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  college         College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  createdBy       User              @relation("HackathonCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  teams           HackathonTeam[]
  participants    HackathonParticipant[]
  
  @@index([collegeId])
  @@index([status])
  @@index([startDate])
  @@index([createdByUserId])
  @@map("hackathon")
}

model HackathonTeam {
  id              String   @id @default(cuid())
  hackathonId     String
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  leaderUserId    String   // Team lead
  
  // Submission details (after hackathon)
  projectTitle    String?  @db.VarChar(255)
  projectDescription String? @db.Text
  repositoryUrl   String?  @db.VarChar(500)
  demoUrl         String?  @db.VarChar(500)
  
  // Scoring (if applicable)
  score           Float?
  ranking         Int?     // null until results announced
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  hackathon       Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  leader          User      @relation("HackathonTeamLead", fields: [leaderUserId], references: [id], onDelete: Restrict)
  members         HackathonParticipant[]
  
  @@index([hackathonId])
  @@index([leaderUserId])
  @@index([ranking])
  @@map("hackathon_team")
}

model HackathonParticipant {
  id              String   @id @default(cuid())
  hackathonId     String
  teamId          String?  // null if not in a team (waiting/solo)
  userId          String
  
  // Participation status
  joinedAt        DateTime @default(now())
  status          String   @default("active") // active, withdrew, disqualified
  
  // Roles (track what each person did)
  contributions   String?  @db.Text // JSON: { code: num_commits, docs: bool, presentation: bool, etc. }
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  hackathon       Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  team            HackathonTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  user            User      @relation("HackathonParticipants", fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([hackathonId, userId]) // One user per hackathon
  @@index([hackathonId])
  @@index([teamId])
  @@index([userId])
  @@index([status])
  @@map("hackathon_participant")
}

