generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─── Auth Models ─────────────────────────────────────────────────────────────



// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  student
  mentor
  instructor_staff
  dept_admin
  hod
  principal
  college_admin
  super_admin
  product_admin
}

enum SubmissionStatus {
  processing
  accepted
  wrong_answer
  time_limit_exceeded
  memory_limit_exceeded
  runtime_error
  compilation_error
  internal_error
}

enum ContestType {
  contest
  practice
}

enum TestStatus {
  draft
  scheduled
  active
  completed
  archived
}

enum QuestionType {
  // Practice/contest problem types
  mcq
  dsa
  arduino
  // Test management question types
  multiple_choice
  true_false
  short_answer
  long_answer
  coding
}

enum ProctoringViolationType {
  NO_FACE_DETECTED
  MULTIPLE_FACES
  OFF_SCREEN_GAZE
  TAB_SWITCH
  FULLSCREEN_EXIT
  OTHER
}

enum ProctoringReviewStatus {
  pending
  confirmed
  dismissed
  needs_review
}

enum ProctoringSeverity {
  low
  medium
  high
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  name          String
  passwordHash  String
  role          Role      @default(student)
  emailVerified Boolean   @default(false)
  phone         String?
  image         String?
  collegeId     String?
  college       College?    @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  departmentId  String?
  department    Department? @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  batchId       String?
  batch         Batch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  refreshTokens       RefreshToken[]
  sessions            Session[]
  accounts            Account[]
  submissions         Submission[]
  participations      ContestParticipation[]
  arduinoSubmissions  ArduinoSubmission[]
  codeDrafts          CodeDraft[]
  dailyChallengeSolves DailyChallengeSolve[]
  userStreak          UserStreak?
  mcqPracticeSessions MCQPracticeSession[]
  practiceActivities  PracticeActivity[]
  practiceRandomSets  PracticeRandomSet[]

  // College-admin flow
  mentoredBatches Batch[]      @relation("BatchMentor")
  createdTests    Test[]       @relation("TestCreatedBy")
  testAttempts    TestAttempt[] @relation("StudentTestAttempts")
  proctoringVideos        ProctoringVideo[] @relation("ProctoringVideoStudent")
  reviewedProctoringVideos ProctoringVideo[] @relation("ProctoringVideoReviewer")
  departmentAsHod Department?  @relation("DepartmentHod")

  @@index([departmentId])
  @@index([batchId])
  @@index([collegeId])
  @@index([role])
  @@map("user")
}

// Stores active refresh tokens (one per device/session).
// Deleted on sign-out or when a new sign-in invalidates all previous sessions.
model RefreshToken {
  id        String   @id @default(cuid())
  jti       String   @unique   // JWT ID — used to look up and revoke tokens
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

// Stores temporary OTP codes for email verification and password reset.
// identifier = "<email>:<type>"  e.g. "user@example.com:email-verification"
// value      = SHA-256 hash of the 6-digit OTP
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Better-Auth Models ──────────────────────────────────────────────────────

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("session")
}

model Account {
  id                 String   @id
  accountId          String
  providerId         String
  userId             String
  accessToken        String?  @db.Text
  refreshToken       String?  @db.Text
  idToken            String?  @db.Text
  expiresAt          DateTime?
  password           String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@index([userId])
  @@map("account")
}

model College {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  description String?
  website     String?
  location    String?
  adminId     String?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  departments Department[]

  @@index([adminId])
  @@index([createdById])
  @@map("college")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  collegeId   String?
  college     College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  hodId       String?  @unique
  hod         User?    @relation("DepartmentHod", fields: [hodId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]   @relation("UserDepartment")
  batches     Batch[]
  tests       Test[]

  @@index([collegeId])
  @@index([hodId])
  @@map("department")
}

model Batch {
  id           String      @id @default(cuid())
  name         String
  code         String
  year         Int
  semester     Int?
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  mentorId     String?
  mentor       User?       @relation("BatchMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  students     User[]
  tests        Test[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([code, departmentId])
  @@index([departmentId])
  @@index([mentorId])
  @@map("batch")
}
enum McqSessionStatus {
  in_progress
  submitted
}

// ─── Models ──────────────────────────────────────────────────────────────────



model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  type      String     // "topic" or "company"
  questions Question[]

  @@map("tag")
}

model Question {
  id          String       @id @default(cuid())
  type        QuestionType
  title       String
  content     String?      // markdown for DSA, text for MCQ (alternate to description)
  description String       // markdown for DSA, text for MCQ
  difficulty  String       // "easy", "medium", "hard"
  tags        Tag[]
  company     String?
  createdBy   String       // admin user ID
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  // Test relationship
  testId      String?
  test        Test?        @relation(fields: [testId], references: [id], onDelete: Cascade)

  // Marks and ordering for tests
  marks       Int?         // Points for this question in a test
  orderIndex  Int?         // Order of question within test

  // MCQ-specific
  options       Json?  // ["A) Option 1", ...]
  correctAnswer Int?   // 0-3
  explanation   String? // Explanation for the correct answer

  // DSA-specific
  timeLimit       Int?   // seconds
  memoryLimit     Int?   // KB
  sampleTestCases Json?  // [{input, output, explanation}]
  hiddenTestCases Json?  // [{input, expectedOutput}]

  contests ContestQuestion[]
  arduinoProblem ArduinoProblem?
  dailyChallenges DailyChallenge[]
  mcqSessionAnswers MCQSessionAnswer[]

  @@map("question")
}

// ─── Contest Models ──────────────────────────────────────────────────────────

model Contest {
  id          String      @id @default(cuid())
  title       String
  description String
  type        ContestType @default(contest)
  startTime   DateTime?
  endTime     DateTime?
  duration    Int?        // minutes
  createdBy   String      // admin user ID
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  questions      ContestQuestion[]
  participations ContestParticipation[]

  @@map("contest")
}

model ContestQuestion {
  contestId  String
  questionId String
  order      Int    // display order
  points     Int    // points awarded

  contest  Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([contestId, questionId])
  @@map("contest_question")
}

model ContestParticipation {
  id          String    @id @default(cuid())
  userId      String
  contestId   String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Int       @default(0)
  mcqAnswers  Json?     // {questionId: selectedOptionIndex}

  dsaSubmissions     Submission[]
  arduinoSubmissions ArduinoSubmission[]
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest            Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([userId, contestId])
  @@map("contest_participation")
}

// ─── Submission Model ─────────────────────────────────────────────────────────

model Submission {
  id              String           @id @default(cuid())
  userId          String
  problemId       String           // references JSON slug (will migrate to questionId)
  language        String?
  languageId      Int?
  sourceCode      String?
  status          SubmissionStatus @default(processing)
  testCasesPassed Int              @default(0)
  totalTestCases  Int              @default(0)
  failedAt        Int?             // 1-indexed test case that failed
  runtime         String?
  memory          Int?             // peak memory in KB
  errorOutput     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  contestParticipationId String?
  contestParticipation   ContestParticipation? @relation(fields: [contestParticipationId], references: [id])
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([problemId])
  @@index([userId, problemId])
  @@map("submission")
}

model Test {
  id                  String       @id @default(cuid())
  title               String
  description         String?
  instructions        String?
  status              TestStatus   @default(draft)
  durationMinutes     Int          @default(60)
  maxAttempts         Int          @default(1)
  totalMarks          Int          @default(0)
  passingMarks        Int?
  scheduledStartTime  DateTime?
  scheduledEndTime    DateTime?
  departmentId        String?
  department          Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  batchId             String?
  batch               Batch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdById         String
  createdBy           User         @relation("TestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  questions           Question[]
  attempts            TestAttempt[]
  proctoringVideos    ProctoringVideo[]

  @@index([status])
  @@index([departmentId])
  @@index([batchId])
  @@index([createdById])
  @@index([scheduledStartTime])
  @@map("test")
}

// ─── Arduino Models ──────────────────────────────────────────────────────────

model ArduinoProblem {
  id               String   @id @default(cuid())
  questionId       String   @unique
  board            String   // "uno" | "mega"
  fqbn             String   // "arduino:avr:uno" | "arduino:avr:mega"
  libraries        String[] // ["Servo.h", "Wire.h"]
  starterCode      String   @db.Text
  simulationConfig Json     // Wokwi diagram JSON
  timeLimitMs      Int      @default(2000)
  memoryLimitKb    Int      @default(256)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  testCases    ArduinoTestCase[]
  submissions  ArduinoSubmission[]
  question     Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("arduino_problem")
}

model ArduinoTestCase {
  id             String  @id @default(cuid())
  problemId      String
  label          String  // "LED blinks every 1 second"
  type           String  // "pin_state" | "toggle_count" | "serial_output"
  isHidden       Boolean @default(false)
  pin            Int?
  expectedState  String? // "HIGH" | "LOW"
  atMs           Int?
  toleranceMs    Int?    @default(100)
  minToggles     Int?
  withinMs       Int?
  expectedOutput String? @db.Text
  order          Int

  problem ArduinoProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@map("arduino_test_case")
}

model ArduinoSubmission {
  id              String           @id @default(cuid())
  userId          String
  problemId       String
  sourceCode      String           @db.Text
  status          SubmissionStatus @default(processing)
  hexFile         String?          @db.Text // Updated to store hex content instead of URL
  verdict         Json?            // Detailed test results
  testCasesPassed Int              @default(0)
  totalTestCases  Int              @default(0)
  compileTime     Int?             // milliseconds
  runtime         String?          // simulated execution time
  errorOutput     String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  contestParticipationId String?
  contestParticipation   ContestParticipation? @relation(fields: [contestParticipationId], references: [id])
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem                ArduinoProblem        @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([problemId])
  @@index([userId, problemId])
  @@map("arduino_submission")
}

model TestAttempt {
  id            String    @id @default(cuid())
  testId        String
  test          Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId     String
  student       User      @relation("StudentTestAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber Int       @default(1)
  status        String    @default("in_progress")
  score         Float?
  maxScore      Float
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  evaluatedAt   DateTime?
  answers       Json?
  feedback      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  proctoringVideos ProctoringVideo[]

  @@unique([testId, studentId, attemptNumber])
  @@index([testId])
  @@index([studentId])
  @@index([status])
  @@map("test_attempt")
}

model CodeDraft {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  code      String   @db.Text
  language  String?  // "cpp" for Arduino, or Judge0 language for DSA
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
  @@map("code_draft")
}

// ─── Student POTD Models ─────────────────────────────────────────────────────

model DailyChallenge {
  id        String   @id @default(cuid())
  questionId String
  date      DateTime @db.Date
  createdBy String
  createdAt DateTime @default(now())

  solves   DailyChallengeSolve[]
  question Question              @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([date])
  @@index([date])
  @@map("daily_challenge")
}

model DailyChallengeSolve {
  id               String  @id @default(cuid())
  userId           String
  dailyChallengeId String
  selectedOption   Int?
  isCorrect        Boolean
  attempts         Int     @default(1)
  languageId       Int?
  sourceCode       String? @db.Text
  solvedAt         DateTime @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyChallenge  DailyChallenge  @relation(fields: [dailyChallengeId], references: [id], onDelete: Cascade)

  @@unique([userId, dailyChallengeId])
  @@index([userId])
  @@index([dailyChallengeId])
  @@map("daily_challenge_solve")
}

model UserStreak {
  id             String    @id @default(cuid())
  userId         String    @unique
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastSolveDate  DateTime? @db.Date
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streak")
}

// ─── MCQ Practice Models ─────────────────────────────────────────────────────

model ProctoringVideo {
  id            String                 @id @default(cuid())
  studentId     String
  testId        String
  attemptId     String
  objectKey     String
  mimeType      String
  violationType ProctoringViolationType
  startedAt     DateTime
  endedAt       DateTime
  durationMs    Int
  meta          Json?
  clientEventId String?
  reviewStatus  ProctoringReviewStatus @default(pending)
  reviewNote    String?
  severity      ProctoringSeverity?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  student    User        @relation("ProctoringVideoStudent", fields: [studentId], references: [id], onDelete: Cascade)
  test       Test        @relation(fields: [testId], references: [id], onDelete: Cascade)
  attempt    TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  reviewedBy User?       @relation("ProctoringVideoReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([studentId, clientEventId])
  @@index([testId])
  @@index([attemptId])
  @@index([studentId])
  @@index([violationType])
  @@index([reviewStatus])
  @@index([createdAt])
  @@map("proctoring_video")
}

model MCQPracticeSession {
  id              String           @id @default(cuid())
  userId          String
  topics          Json
  difficulty      String?
  requestedCount  Int
  totalQuestions  Int
  questionIds     Json
  status          McqSessionStatus @default(in_progress)
  score           Int              @default(0)
  correctCount    Int              @default(0)
  submittedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers MCQSessionAnswer[]

  @@index([userId])
  @@index([userId, createdAt])
  @@map("mcq_practice_session")
}

model MCQSessionAnswer {
  id             String @id @default(cuid())
  sessionId      String
  questionId     String
  selectedOption Int
  correctAnswer  Int
  isCorrect      Boolean
  points         Int      @default(0)
  createdAt      DateTime @default(now())

  session  MCQPracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
  @@map("mcq_practice_answer")
}

// ─── Practice Activity Models ────────────────────────────────────────────────

model PracticeActivity {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @db.Date
  problemsSolved Int      @default(0)
  mcqSolved      Int      @default(0)
  dsaSolved      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_practice_activity")
}

model PracticeRandomSet {
  id          String    @id @default(cuid())
  userId      String
  seed        String?
  filters     Json
  questionIds Json
  count       Int
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("practice_random_set")
}
