{
  "name": "codeethnics-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "db:patch:better-auth-account-columns": "prisma db execute --schema src/modules/prisma/schema.prisma --file src/modules/prisma/migrations/20260425143000_add_missing_account_expiry_columns/migration.sql",
    "db:patch:question-columns": "prisma db execute --schema src/modules/prisma/schema.prisma --file src/modules/prisma/migrations/20260425184500_add_missing_question_columns/migration.sql",
    "db:patch:test-public-columns": "prisma db execute --schema src/modules/prisma/schema.prisma --file src/modules/prisma/migrations/20260414123000_add_missing_test_public_columns/migration.sql",
    "predev": "pnpm run db:patch:test-public-columns && pnpm run db:patch:better-auth-account-columns && pnpm run db:patch:question-columns && prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/src/server.js",
    "worker:dev": "tsx watch src/workers/arduino-worker.ts",
    "worker:build": "tsc && node dist/src/workers/arduino-worker.js",
    "worker:start": "node dist/src/workers/arduino-worker.js",
    "arduino:compiler": "cd arduino-compiler && pnpm run dev",
    "arduino:build": "cd arduino-compiler && pnpm run build",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down -v",
    "stack:logs": "docker compose logs -f --tail=200",
    "seed": "tsx src/scripts/seed.ts",
    "seed:mcq": "tsx src/scripts/seed-mcq.ts",
    "seed:coding": "tsx src/scripts/seed-coding.ts",
    "seed:questions": "tsx src/scripts/import-questions-json.ts",
    "seed:college": "tsx src/scripts/college-seed.ts",
    "seed:college:performance": "tsx src/scripts/college-performance-seed.ts",
    "seed:product": "tsx src/scripts/product-seed.ts",
    "stack:setup": "docker compose up -d && sleep 10 && pnpm exec prisma migrate deploy && pnpm exec prisma db seed",
    "db:tables": "tsx src/scripts/show-tables.ts",
    "vercel-build": "pnpm run db:patch:test-public-columns && pnpm run db:patch:better-auth-account-columns && pnpm run db:patch:question-columns && prisma generate && tsc",
    "test": "vitest run",
    "test:auth": "tsx test/auth.test.ts",
    "test:judge0": "RUN_JUDGE0_INTEGRATION=true vitest run test/judge0.integration.test.ts",
    "test:problems": "vitest run test/problem.fetch.test.ts",
    "test:arduino": "vitest run test/arduino.integration.test.ts",
    "test:arduino:unit": "vitest run test/arduino.unit.test.ts",
    "test:arduino:integration": "vitest run test/arduino.advanced.integration.test.ts",
    "test:arduino:load": "vitest run test/load-tests/arduino.load.test.ts --testTimeout=120000",
    "test:arduino:all": "pnpm run test:arduino:unit && pnpm run test:arduino:integration && pnpm run test:arduino:load",
    "smoke:arduino": "tsx test/arduino.smoke-test.ts",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:integration": "vitest run src/__tests__/college-admin/integration.test.ts",
    "test:unit": "vitest run --exclude src/__tests__/college-admin/integration.test.ts",
    "test:full": "pnpm run test:arduino:all && pnpm run test:judge0 && pnpm run test && pnpm run smoke:arduino",
    "docker:build": "docker build -t codeethnics-backend .",
    "docker:build:worker": "docker build -f Dockerfile.worker -t codeethnics-worker .",
    "docker:test": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.1",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1024.0",
    "@aws-sdk/s3-request-presigner": "^3.1024.0",
    "@imagekit/nodejs": "^7.4.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@types/uuid": "^11.0.0",
    "avr8js": "^0.21.0",
    "axios": "^1.14.0",
    "bcrypt": "^5.1.1",
    "better-auth": "^1.5.5",
    "bullmq": "^5.71.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.3.1",
    "google-auth-library": "^10.6.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.1",
    "pg": "^8.20.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.3",
    "uuid": "^9.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.3.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/ui": "^4.0.18",
    "prisma": "^7.6.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
