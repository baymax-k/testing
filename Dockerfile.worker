# ─── Stage 1: Base ────────────────────────────────────────────────────────────
FROM node:20-alpine AS base
WORKDIR /app
RUN npm install -g pnpm
COPY package*.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# ─── Stage 2: Builder ─────────────────────────────────────────────────────────
FROM base AS builder
WORKDIR /app
COPY . .
RUN pnpm prisma generate
RUN pnpm build

# ─── Stage 3: Arduino Worker ──────────────────────────────────────────────────
FROM node:20-alpine AS arduino-worker
WORKDIR /app
RUN npm install -g pnpm

# node_modules from builder already contains the generated Prisma client
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package*.json ./

# Copy prisma schema
COPY --from=builder /app/src/modules/prisma/schema.prisma ./src/modules/prisma/schema.prisma

# Install Arduino CLI
RUN apk add --no-cache curl
RUN curl -fsSL https://raw.githubusercontent.com/arduino/arduino-cli/master/install.sh | BINDIR=/usr/local/bin sh
RUN arduino-cli core update-index
RUN arduino-cli core install arduino:avr

# Create non-root user for security
RUN addgroup -g 1001 -S worker && \
    adduser -S worker -u 1001
USER worker

CMD ["node", "dist/src/workers/arduino-worker.js"]