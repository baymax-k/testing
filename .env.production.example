# ─── PRODUCTION ENVIRONMENT TEMPLATE ──────────────────────────────────────────
# Copy this file, rename to .env.production, and fill in all values
# DO NOT commit this file to git

# ─── Core Configuration ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
APP_URL=https://api.codeethnics.com

# ─── Database (AWS RDS PostgreSQL) ────────────────────────────────────────────
# Connection string format: postgresql://user:password@host:port/database?schema=public&sslmode=require
# Ensure ?sslmode=require is appended for AWS RDS
DATABASE_URL="postgresql://postgres:YOUR_SECURE_PASSWORD@your-rds-endpoint.amazonaws.com:5432/codeethnics?schema=public&sslmode=require"

# ─── Redis (Upstash or AWS ElastiCache) ──────────────────────────────────────
# For Upstash: redis://default:YOUR_API_TOKEN@your-endpoint.upstash.io
# For ElastiCache: redis://:YOUR_AUTH_TOKEN@your-endpoint.cache.amazonaws.com:6379
REDIS_URL="redis://default:YOUR_REDIS_TOKEN@your-redis-endpoint.upstash.io"

# ─── JWT Secrets (Generate with: openssl rand -base64 32) ──────────────────────
# IMPORTANT: Use DIFFERENT values for each environment
# IMPORTANT: Never reuse development secrets in production
JWT_SECRET="GENERATE_NEW_RANDOM_VALUE_MIN_32_CHARS"
JWT_REFRESH_SECRET="GENERATE_NEW_RANDOM_VALUE_MIN_32_CHARS"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Better Auth Secret ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="GENERATE_NEW_RANDOM_VALUE"

# ─── CORS / Frontend Origins (REQUIRED in production) ────────────────────────
# Comma-separated list of allowed frontend URLs
CORS_ORIGINS=https://app.codeethnics.com,https://www.codeethnics.com
FRONTEND_URL=https://app.codeethnics.com

# ─── Email Configuration (AWS SES for production) ──────────────────────────────
# Use AWS SES, not development email provider
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USER=your-ses-smtp-username
EMAIL_PASS=your-ses-smtp-password
EMAIL_FROM=noreply@codeethnics.com

# ─── Judge0 API (Code Execution) ──────────────────────────────────────────────
# Can be self-hosted or Judge0 Cloud
JUDGE0_URL=https://api.judge0.com
JUDGE0_API_KEY=YOUR_JUDGE0_API_KEY

# ─── Arduino Compiler Service ────────────────────────────────────────────────
# Your own arduino-compiler service or public instance
ARDUINO_COMPILER_URL=https://arduino-compiler.codeethnics.com
ARDUINO_CLI_PATH=/usr/local/bin/arduino-cli

# ─── CDN / File Storage (ImageKit or Cloudinary) ──────────────────────────────
# For storing HEX files, problem descriptions, images
CDN_API_KEY=YOUR_CDN_API_KEY
CDN_API_SECRET=YOUR_CDN_API_SECRET
CDN_ENDPOINT=https://ik.imagekit.io/YOUR_DOMAIN

# ─── Optional: Monitoring & Logging ─────────────────────────────────────────
# Add your monitoring service credentials here
SENTRY_DSN=YOUR_SENTRY_DSN
LOG_LEVEL=info

# ─── IMPORTANT REMINDERS ───────────────────────────────────────────────────
# ✅ All secrets should be generated or fetched from secure vaults
# ✅ Use AWS Secrets Manager, HashiCorp Vault, or similar
# ✅ Rotate secrets regularly
# ✅ Never log sensitive values
# ✅ Use different credentials for each environment
# ✅ Implement certificate pinning for external APIs
# ✅ Monitor for unauthorized access attempts
