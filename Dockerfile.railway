# ─── Railway Optimized Docker Build ───────────────────────────────────────────
# This Dockerfile is optimized for Railway deployment
# Build: pnpm run build
# Start: node dist/src/server.js

# Stage 1: Builder
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install pnpm
RUN npm install -g pnpm@10.30.1

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY src ./src
COPY tsconfig.json ./
COPY prisma.config.ts ./

# Generate Prisma client (schema lives at src/modules/prisma/schema.prisma)
RUN pnpm exec prisma generate --schema src/modules/prisma/schema.prisma

# Build TypeScript
RUN pnpm run build

# ─── Runtime Stage ────────────────────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

# Install curl for health checks and dumb-init for signal handling
RUN apk add --no-cache curl dumb-init

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install pnpm
RUN npm install -g pnpm@10.30.1

# Install production dependencies only
RUN pnpm install --frozen-lockfile --prod

# Copy built application from builder
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

# Copy Prisma schema (needed for any runtime Prisma CLI operations)
COPY --from=builder /app/src/modules/prisma ./src/modules/prisma

# Copy startup script
COPY start.sh ./start.sh
RUN chmod +x start.sh

# Copy public assets
COPY public ./public

# Change ownership to non-root user
RUN chown -R nodejs:nodejs /app

USER nodejs

# ─── Environment & Port ────────────────────────────────────────────────────
ENV NODE_ENV=production
EXPOSE 5000

# ─── Health Check ──────────────────────────────────────────────────────────
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:${PORT:-5000}/api/v1/health || exit 1

# ─── Start Server ──────────────────────────────────────────────────────────
ENTRYPOINT ["dumb-init", "--"]
CMD ["sh", "start.sh"]
