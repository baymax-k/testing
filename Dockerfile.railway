# ─── Railway Backend — Single Stage Build ─────────────────────────────────────
# Single stage avoids cross-stage COPY issues with Prisma generated files.

FROM node:20-alpine

WORKDIR /app

# Install system deps
RUN apk add --no-cache curl dumb-init

RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Install pnpm
RUN npm install -g pnpm@10.30.1

# Copy package files and install ALL dependencies (dev + prod needed for build)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# Copy source
COPY src ./src
COPY tsconfig.json ./
COPY public ./public
COPY start.sh ./start.sh
RUN chmod +x start.sh

# Generate Prisma client
RUN pnpm exec prisma generate --schema src/modules/prisma/schema.prisma

# Build TypeScript
RUN pnpm run build:docker

# Remove dev dependencies after build
RUN pnpm prune --prod

# Fix ownership (run before chown to reduce scope)
RUN chown -R nodejs:nodejs /app

USER nodejs

ENV NODE_ENV=production
EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:${PORT:-5000}/api/v1/health || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/src/server.js"]
