# ─── Database ─────────────────────────────────────────────────────────────────
# Local:  postgresql://postgres:password@localhost:5432/codeethnics?schema=public
# AWS RDS (ap-south-1): add ?sslmode=require for RDS
DATABASE_URL="postgresql://postgres:password@localhost:5432/codeethnics?schema=public"

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_URL="http://localhost:5000"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Use DIFFERENT values for each secret
JWT_SECRET="your-random-access-token-secret-min-32-chars"
JWT_REFRESH_SECRET="your-random-refresh-token-secret-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Email (Mailtrap for dev, AWS SES for prod) ───────────────────────────────
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="CodeEthnics <no-reply@codeethnics.com>"

# ─── CORS / Frontend ──────────────────────────────────────────────────────────
# Comma-separated origins: CORS_ORIGINS=https://app.codeethnics.com,https://www.codeethnics.com
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=

# ─── Google Auth ──────────────────────────────────────────────────────────────
# OAuth client ID used to verify Google ID tokens from frontend sign-in
GOOGLE_CLIENT_ID=

# ─── Redis (for BullMQ and Rate Limiting) ─────────────────────────────────────
# Option A: full URL (takes precedence)
#   REDIS_URL=redis://default:<password>@localhost:6379
# Option B: host/port/password (used when REDIS_URL is not set)
#   REDIS_HOST=localhost
#   REDIS_PORT=6379
#   REDIS_PASSWORD=yourpassword
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Arduino Compiler Service ─────────────────────────────────────────────────
# Internal service URL (not publicly accessible)
# Local: http://localhost:3001
# Docker: http://arduino-compiler:3001 (internal network)  
# Render: http://arduino-compiler.onrender.com (internal network)
# AWS: http://compiler.internal:8080 (VPC private)
ARDUINO_SERVICE_URL=http://localhost:3001

# Compilation timeout in seconds (default: 30s)
ARDUINO_COMPILE_TIMEOUT=30

# Maximum compilation jobs per user per minute (default: 5)
ARDUINO_COMPILE_RATE_LIMIT=5

# Worker concurrency (number of parallel compilation jobs)
ARDUINO_WORKER_CONCURRENCY=5

# Simulation timeout for grading in seconds (default: 15s real time for 10s simulated)
ARDUINO_SIMULATION_TIMEOUT=15
