# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL root password (used by docker-compose.yml)
# CRITICAL: Use strong, unique password in production
# Generate with: openssl rand -base64 32
DB_PASSWORD=your_strong_db_password_here

# Database connection string (used by application)
# Local:  postgresql://postgres:${DB_PASSWORD}@localhost:5432/codeethnics?schema=public
# AWS RDS (ap-south-1): add ?sslmode=require for RDS
DATABASE_URL="postgresql://postgres:${DB_PASSWORD}@localhost:5432/codeethnics?schema=public"

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_URL="http://localhost:5000"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Use DIFFERENT values for each secret
JWT_SECRET="your-random-access-token-secret-min-32-chars"
JWT_REFRESH_SECRET="your-random-refresh-token-secret-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Email (Mailtrap for dev, AWS SES for prod) ───────────────────────────────
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="CodeEthnics <no-reply@codeethnics.com>"

# ─── CORS / Frontend ──────────────────────────────────────────────────────────
# Comma-separated origins: CORS_ORIGINS=https://app.codeethnics.com,https://www.codeethnics.com
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=

# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis password (used by docker-compose.yml)
# CRITICAL: Use strong, unique password in production
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=your_strong_redis_password_here

# Redis connection URL for application
# Used in docker-compose: redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_URL="redis://:${REDIS_PASSWORD}@localhost:6379/1"
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Arduino Compiler ─────────────────────────────────────────────────────────
# Arduino compiler service (runs in Docker)
ARDUINO_COMPILER_URL="http://localhost:3001"
ARDUINO_CLI_PATH="/usr/local/bin/arduino-cli"

# ─── CDN Storage ──────────────────────────────────────────────────────────────
# ImageKit or Cloudinary for storing HEX files and other assets
CDN_API_KEY="your-cdn-api-key"
CDN_API_SECRET="your-cdn-api-secret"
CDN_ENDPOINT="https://ik.imagekit.io/your-id"

# ─── Judge0 Configuration ─────────────────────────────────────────────────────
# Judge0 API for DSA code execution
# Local development: http://localhost:2358 (when running backend with pnpm dev)
# Docker network: http://judge0-server:2358 (when running backend in Docker)
# Production: Use internal service URL or load balancer
JUDGE0_URL="http://localhost:2358"

# Optional: Authentication token for Judge0 API
# Leave empty if authentication is disabled in judge0.conf
JUDGE0_AUTH_TOKEN=

# ─── Better Auth Configuration ────────────────────────────────────────────────
# Secret key for Better Auth JWT signing
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:5000
POSTGRES_PORT="5432"
POSTGRES_DB="codeethnics"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"

# Judge0 connection (runs in Docker)
JUDGE0_URL="http://localhost:2358"
JUDGE0_API_KEY=""

# ─── Production Settings ──────────────────────────────────────────────────────
# Only set these in production environment
SENTRY_DSN=""
ELASTICSEARCH_URL=""
MONITORING_API_KEY=""

# ─── Google Auth ──────────────────────────────────────────────────────────────
# OAuth client ID used to verify Google ID tokens from frontend sign-in
GOOGLE_CLIENT_ID=

# ─── Proctoring (AWS S3) ─────────────────────────────────────────────────────
# Required for signed upload/access URLs
AWS_REGION=
AWS_S3_BUCKET_PROCTORING=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional overrides
AWS_S3_UPLOAD_URL_TTL_SECONDS=300
AWS_S3_READ_URL_TTL_SECONDS=180
PROCTORING_MAX_UPLOAD_BYTES=26214400

# ─── Redis (for BullMQ and Rate Limiting) ─────────────────────────────────────
# Option A: full URL (takes precedence)
#   REDIS_URL=redis://default:<password>@localhost:6379
# Option B: host/port/password (used when REDIS_URL is not set)
#   REDIS_HOST=localhost
#   REDIS_PORT=6379
#   REDIS_PASSWORD=yourpassword
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Arduino Compiler Service ─────────────────────────────────────────────────
# Internal service URL (not publicly accessible)
# Local: http://localhost:3001
# Docker: http://arduino-compiler:3001 (internal network)  
# Render: http://arduino-compiler.onrender.com (internal network)
# AWS: http://compiler.internal:8080 (VPC private)
ARDUINO_SERVICE_URL=http://localhost:3001

# Compilation timeout in seconds (default: 30s)
ARDUINO_COMPILE_TIMEOUT=30

# Maximum compilation jobs per user per minute (default: 5)
ARDUINO_COMPILE_RATE_LIMIT=5

# Worker concurrency (number of parallel compilation jobs)
ARDUINO_WORKER_CONCURRENCY=5

# Simulation timeout for grading in seconds (default: 15s real time for 10s simulated)
ARDUINO_SIMULATION_TIMEOUT=15

# ─── Optional: Monitoring & Logging ─────────────────────────────────────────
# Add your monitoring service credentials here
LOG_LEVEL=info
