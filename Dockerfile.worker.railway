# ─── Arduino Worker — Railway Deployment ──────────────────────────────────────
# BullMQ worker that picks up Arduino compile jobs from Redis queue,
# calls the arduino-compiler service, and writes results back to the DB.
# NOTE: This worker does NOT need Arduino CLI — compilation is delegated
# to the arduino-compiler service. It only needs Node + Prisma.

# Stage 1: Builder
FROM node:20-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm@10.30.1

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY src ./src
COPY tsconfig.json ./

# Generate Prisma client with explicit schema path (no prisma.config.ts needed at build time)
RUN pnpm exec prisma generate --schema src/modules/prisma/schema.prisma

# Build TypeScript only (prisma generate already done above)
RUN pnpm run build:docker

# Stage 2: Runtime
FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache dumb-init curl

# Create non-root user
RUN addgroup -g 1001 -S worker && \
    adduser -S worker -u 1001 -G worker

RUN npm install -g pnpm@10.30.1

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --prod

# Generate Prisma client in runtime stage
COPY --from=builder /app/src/modules/prisma ./src/modules/prisma
RUN pnpm exec prisma generate --schema src/modules/prisma/schema.prisma

# Copy built output
COPY --from=builder /app/dist ./dist

RUN chown -R worker:worker /app

USER worker

ENV NODE_ENV=production

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/src/workers/arduino-worker.js"]
