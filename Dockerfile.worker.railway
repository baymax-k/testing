# ─── Arduino Worker — Railway Single Stage Build ──────────────────────────────
# Single stage avoids cross-stage COPY issues with Prisma generated files.
# Worker does NOT need Arduino CLI — compilation is delegated to arduino-compiler.

FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache dumb-init curl

# Create non-root user
RUN addgroup -g 1001 -S worker && \
    adduser -S worker -u 1001 -G worker

RUN npm install -g pnpm@10.30.1

# Install ALL dependencies (dev + prod needed for build)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY src ./src
COPY tsconfig.json ./

# Generate Prisma client
RUN pnpm exec prisma generate --schema src/modules/prisma/schema.prisma

# Build TypeScript
RUN pnpm run build:docker

# Remove dev dependencies after build
RUN pnpm prune --prod

RUN chown -R worker:worker /app

USER worker

ENV NODE_ENV=production

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/src/workers/arduino-worker.js"]
