# ─── Arduino Compiler Service — Railway Deployment ────────────────────────────
# Standalone microservice that wraps Arduino CLI for code compilation.
# Uses node:20-bullseye (Debian) as base — Node.js pre-installed, stable on Railway.

FROM node:20-bullseye

# Install system dependencies + Arduino CLI
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Arduino CLI globally
RUN curl -fsSL https://raw.githubusercontent.com/arduino/arduino-cli/master/install.sh | BINDIR=/usr/local/bin sh

# Install pnpm
RUN npm install -g pnpm@10.30.1

# Create non-root user
RUN useradd -m -s /bin/bash -u 1001 arduino

WORKDIR /app

# Copy package files and install dependencies (as root)
COPY package.json ./
RUN pnpm install --no-frozen-lockfile

# Copy source and build (as root)
COPY tsconfig.json ./
COPY src/ ./src/
RUN pnpm run build

# Set up uploads directory and fix ownership BEFORE switching user
RUN mkdir -p /app/uploads && \
    chown -R arduino:arduino /app

# Switch to non-root user for Arduino core installation
# This ensures cores are installed in /home/arduino/.arduino15
# which is accessible at runtime under the same user
USER arduino

ENV ARDUINO_CLI_PATH=/usr/local/bin/arduino-cli
ENV ARDUINO_DATA_DIR=/home/arduino/.arduino15
ENV ARDUINO_DOWNLOADS_DIR=/home/arduino/.arduino15/staging
ENV ARDUINO_USER_DIR=/home/arduino/Arduino

# Install Arduino board cores as the arduino user
RUN arduino-cli core update-index && \
    arduino-cli core install arduino:avr

# Warm up compiler cache — pre-compiles dummy sketches to avoid cold-start delays
RUN mkdir -p /tmp/warmup/warmup && \
    echo 'void setup() { Serial.begin(9600); } void loop() { delay(1000); }' \
      > /tmp/warmup/warmup/warmup.ino && \
    arduino-cli compile --fqbn arduino:avr:uno /tmp/warmup/warmup --output-dir /tmp/warmup/uno && \
    arduino-cli compile --fqbn arduino:avr:mega /tmp/warmup/warmup --output-dir /tmp/warmup/mega && \
    rm -rf /tmp/warmup

ENV PORT=8080
ENV NODE_ENV=production

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8080}/health || exit 1

CMD ["node", "dist/server.js"]
